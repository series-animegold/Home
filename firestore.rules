rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow admin (shadowtrimz@gmail.com) full access to everything
    match /{document=**} {
      allow read, write: if request.auth.token.email == "shadowtrimz@gmail.com";
    }
    
    // Allow anyone to CREATE a new user document (for signup)
    match /users/{userId} {
      allow create: if request.auth == null || request.auth.uid != userId;
      
      // Allow users to read/write their own data (after login)
      allow read, write: if request.auth.uid == userId;
    }
  }
}
